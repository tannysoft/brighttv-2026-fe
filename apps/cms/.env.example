# Payload secret: openssl rand -hex 32
PAYLOAD_SECRET=
# Postgres used by `next dev`, the payload CLI and scripts.
#   local:      postgres://payload:payload@127.0.0.1:54329/brighttv_cms   (pnpm db:up)
#   PlanetScale: the direct connection string (with ?sslmode=require)
DATABASE_URL=postgres://payload:payload@127.0.0.1:54329/brighttv_cms
# Shared with apps/web — lets the CMS tell the website to refresh its cache
REVALIDATE_SECRET=
CMS_URL=http://localhost:3001
WEB_URL=http://localhost:3000
# Files are already public on the R2 domain
MEDIA_URL=https://cdn.brighttv.co.th
# Shared with apps/web: the "Preview" button opens drafts on the website
PREVIEW_SECRET=
# Optional, for drafts/private posts and Yoast fields in the import:
# a WordPress user + application password (Users → Profile → Application Passwords)
WP_USER=
WP_APP_PASSWORD=
# Key of the bright-migrate WordPress plugin (Yoast export), see scripts/wp-plugin
WP_MIGRATE_KEY=
