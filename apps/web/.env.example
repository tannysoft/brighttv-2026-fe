# "payload" = new CMS, "wordpress" = old WordPress API
CMS_SOURCE=payload
CMS_URL=http://localhost:3001
MEDIA_URL=https://cdn.brighttv.co.th
SITE_ORIGIN=https://www.brighttv.co.th
WP_API_ORIGIN=https://www.brighttv.co.th
# Same values as apps/cms
REVALIDATE_SECRET=
PREVIEW_SECRET=
# API key of a CMS user (Users → Enable API key) for draft previews
CMS_PREVIEW_API_KEY=
# 1 = robots Disallow + noindex meta (preview host only)
SITE_NOINDEX=
