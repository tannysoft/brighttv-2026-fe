/**
 * Bright TV website (Next.js on Workers via OpenNext).
 *   pnpm --filter @brighttv/web run preview   # build + local wrangler dev
 *   pnpm --filter @brighttv/web run deploy    # build + deploy
 *
 * Workers Builds (every push to main deploys):
 *   Path: /apps/web
 *   Build: pnpm install --frozen-lockfile && pnpm exec opennextjs-cloudflare build
 *   Deploy: pnpm exec opennextjs-cloudflare deploy
 *   Watch paths: apps/web/*, packages/*, pnpm-lock.yaml
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "8a21a543bd0ac55148179deddb67ee1c",
  "name": "brighttv-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "observability": { "enabled": true },
  "minify": true,
  // Preview of the new site. Cutover: replace with the live domains below.
  "routes": [{ "pattern": "new.brighttv.co.th", "custom_domain": true }],
  // "routes": [
  //   { "pattern": "www.brighttv.co.th", "custom_domain": true },
  //   { "pattern": "brighttv.co.th", "custom_domain": true }
  // ],
  "vars": {
    // "wordpress" until the CMS is live with imported content; then "payload".
    "CMS_SOURCE": "wordpress",
    // Remove at cutover (robots + X-Robots-Tag noindex on the preview host)
    "SITE_NOINDEX": "1",
    "SITE_ORIGIN": "https://www.brighttv.co.th",
    "WP_API_ORIGIN": "https://www.brighttv.co.th",
    "CMS_URL": "https://cms.brighttv.co.th",
    "MEDIA_URL": "https://cdn.brighttv.co.th"
  },
  // Secrets (wrangler secret put …): REVALIDATE_SECRET and PREVIEW_SECRET (same
  // values as the CMS), CMS_PREVIEW_API_KEY (API key of a CMS user, for drafts).

  // OpenNext cache (see open-next.config.ts)
  //   npx wrangler r2 bucket create brighttv-web-cache
  //   npx wrangler d1 create brighttv-web-tags        → database_id below
  //   npx wrangler d1 create brighttv-web-views       → database_id below, then
  //   npx wrangler d1 migrations apply brighttv-web-views --remote
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "brighttv-web-cache" }],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "brighttv-web-tags",
      "database_id": "cb884a91-4886-43a1-94ef-a6e78efc67b8"
    },
    {
      "binding": "VIEWS_DB",
      "database_name": "brighttv-web-views",
      "database_id": "1ae8e398-96f0-4944-b250-9371ed54f4e4",
      "migrations_dir": "migrations"
    },
    {
      // Lottery draws, written by the brighttv-lotto job (apps/lotto); read-only here.
      "binding": "LOTTO_DB",
      "database_name": "brighttv-lotto",
      "database_id": "2776ae8c-00b4-45df-8dca-070dfb392830"
    },
    {
      // /horoscope: sections of horoscope articles by day of birth / zodiac
      // and "Pick a card" piles (scripts/horoscope/extract.ts writes it).
      "binding": "HORO_DB",
      "database_name": "brighttv-horoscope",
      "database_id": "0359f785-c52c-4863-9309-6069275ab313"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "brighttv-web" }]
}
